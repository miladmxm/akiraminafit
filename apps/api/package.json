{
  "name": "@akiraminafit/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "esbuild src/index.ts --bundle --platform=node --format=esm --sourcemap --outfile=dist/index.js --external:@aws-sdk/* --external:@better-auth/* --external:@hono/* --external:better-auth --external:dotenv --external:drizzle-orm --external:hono --external:pg --external:zod",
    "start": "node dist/index.js",
    "auth:generate": "pnpm dlx auth@latest generate",
    "seed": "tsx src/seed.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@akiraminafit/contracts": "0.1.0",
    "@akiraminafit/db": "0.1.0",
    "@aws-sdk/client-s3": "^3.864.0",
    "@aws-sdk/s3-request-presigner": "^3.864.0",
    "@better-auth/drizzle-adapter": "^1.6.25",
    "@hono/node-server": "^2.0.8",
    "@hono/zod-validator": "^0.7.2",
    "better-auth": "^1.6.25",
    "dotenv": "^17.2.1",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.12.32",
    "zod": "^4.0.17"
  },
  "devDependencies": {
    "@types/node": "^24.1.0",
    "esbuild": "^0.25.9",
    "tsx": "^4.20.3",
    "typescript": "^5.9.2"
  }
}
