# Application
NODE_ENV=development
PORT=3000
WEB_ORIGIN=http://localhost:5173
API_URL=http://localhost:3000
VITE_API_URL=http://localhost:3000
VITE_DEMO_MODE=true
DEMO_MODE=true

# Docker Compose
COMPOSE_PROJECT_NAME=akiraminafit
DOCKER_RESTART_POLICY=unless-stopped
DOCKER_STOP_GRACE_PERIOD=10s

# PostgreSQL
POSTGRES_IMAGE=postgres:17-alpine
POSTGRES_DB=akiraminafit
POSTGRES_USER=akiraminafit
POSTGRES_PASSWORD=replace-with-a-strong-database-password
POSTGRES_PORT=5432
POSTGRES_INTERNAL_PORT=5432
POSTGRES_HEALTHCHECK_INTERVAL=5s
POSTGRES_HEALTHCHECK_TIMEOUT=5s
POSTGRES_HEALTHCHECK_RETRIES=10
POSTGRES_HEALTHCHECK_START_PERIOD=10s
DATABASE_URL=postgresql://akiraminafit:replace-with-a-strong-database-password@localhost:5432/akiraminafit

# Authentication
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
BETTER_AUTH_URL=http://localhost:3000

# Required by `npm run db:seed`. The account is stored with the `coach` role.
ADMIN_NAME=
ADMIN_EMAIL=
ADMIN_PASSWORD=

# MinIO / S3
# Pin MINIO_IMAGE and MINIO_MC_IMAGE to exact release tags in production.
MINIO_IMAGE=minio/minio:latest
MINIO_MC_IMAGE=minio/mc:latest
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_INTERNAL_API_PORT=9000
MINIO_INTERNAL_CONSOLE_PORT=9001
MINIO_INIT_RETRY_INTERVAL=2
MINIO_INIT_MAX_RETRIES=5
MINIO_BUCKET_ACCESS=download
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=replace-with-a-minio-access-key
S3_SECRET_KEY=replace-with-a-strong-minio-secret-key
S3_BUCKET=akiraminafit-media
S3_PUBLIC_URL=http://localhost:9000/akiraminafit-media
S3_FORCE_PATH_STYLE=true
