NODE_ENV=development
PORT=3000
WEB_ORIGIN=http://localhost:5173
API_URL=http://localhost:3000
VITE_API_URL=http://localhost:3000
VITE_DEMO_MODE=true
DATABASE_URL=postgresql://fitflow:fitflow@localhost:5432/fitflow
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
BETTER_AUTH_URL=http://localhost:3000
DEMO_MODE=true
# Required by `npm run db:seed`. The account is stored with the `coach` role.
ADMIN_NAME=
ADMIN_EMAIL=
ADMIN_PASSWORD=
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=fitflow-media
S3_PUBLIC_URL=http://localhost:9000/fitflow-media
S3_FORCE_PATH_STYLE=true
